# --- Majburiy ---

# @BotFather bergan token
BOT_TOKEN=123456:ABC-DEF...

# Admin Telegram ID lari, vergul bilan. O'z ID'ingizni @userinfobot aytadi
ADMIN_IDS=111111111,222222222

# Mini App joylashgan ochiq HTTPS manzil (Telegram faqat HTTPS ni ochadi).
# Render'da bo'sh qoldirsangiz ham bo'ladi — u manzilni o'zi beradi.
WEBAPP_URL=https://your-domain.example.com


# --- Baza ---

# Bo'sh qoldirilsa SQLite ishlatiladi (DATA_DIR ichida).
# Serverda Postgres tavsiya etiladi — bepul hostinglarda doimiy disk bo'lmaydi:
# DATABASE_URL=postgres://user:parol@host/dbname
DATABASE_URL=

# SQLite fayli qaysi papkada saqlanadi (Postgres ishlatilsa ahamiyatsiz)
# DATA_DIR=/data


# --- Bot rejimi ---

# false — polling (bot yangilanishlarni o'zi so'raydi, xizmat uzluksiz ishlashi kerak)
# true  — webhook (Telegram yangilanishlarni o'zi yuboradi). Uxlab qoladigan
#         bepul hostinglarda shu rejim kerak.
USE_WEBHOOK=false

# Webhook manzili ochiq bo'lgani uchun so'rovlar shu maxfiy kalit bilan
# tekshiriladi. Ixtiyoriy uzun tasodifiy satr.
WEBHOOK_SECRET=

# Birinchi ishga tushishda katalog bo'sh bo'lsa demo xizmatlar qo'shiladi
SEED_DEMO=false
