# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs allowed to use admin commands
ADMIN_IDS=111111111,222222222

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Public HTTPS URL where the React Mini App is hosted (must be HTTPS for Telegram WebApp)
WEBAPP_URL=https://your-domain.example.com

# Base URL of the FastAPI backend, used by the Mini App to fetch the catalog
API_BASE_URL=https://your-domain.example.com/api
