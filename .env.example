# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs allowed to use admin commands.
# Get your own id from @userinfobot
ADMIN_IDS=111111111,222222222

# Public HTTPS URL where the Mini App is served (must be HTTPS for Telegram)
WEBAPP_URL=https://your-domain.example.com

# Where the SQLite database and admin-uploaded images are stored.
# On a server point this at a persistent disk, otherwise everything is lost
# on each redeploy. Defaults to the project directory.
# DATA_DIR=/data

# Optional: override the database URL completely (ignores DATA_DIR)
# DATABASE_URL=sqlite+aiosqlite:///./bot.db
